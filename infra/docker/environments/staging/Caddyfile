# ============================================
# Caddyfile para Staging Environment
# ============================================
# Configuración para staging con soporte para:
# - Subdominios (staging-api.notificaciones.space)
# - Puerto directo (:8080) como fallback
# ============================================

# ============================================
# Opción 1: Subdominios (Recomendado)
# ============================================
# Descomenta y configura estos bloques si tienes DNS configurado
# 
# staging-api.notificaciones.space {
#     # Reverse proxy a Nginx API
#     reverse_proxy nginx-api:80 {
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {remote_host}
#         header_up X-Forwarded-Proto http
#         header_up Host {host}
#         
#         health_uri /up
#         health_interval 30s
#         health_timeout 5s
#     }
# 
#     # Logging
#     log {
#         output stdout
#         format console
#     }
# 
#     # Compression
#     encode gzip
# }
# 
# staging-dashboard.notificaciones.space {
#     # Reverse proxy a Dashboard
#     reverse_proxy dashboard:80 {
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {remote_host}
#         header_up X-Forwarded-Proto http
#         header_up Host {host}
#         
#         health_uri /
#         health_interval 30s
#         health_timeout 5s
#     }
# 
#     # Logging
#     log {
#         output stdout
#         format console
#     }
# 
#     # Compression
#     encode gzip
# }

# ============================================
# Opción 2: Puerto Directo (Fallback)
# ============================================
# Esta configuración funciona sin DNS, usando puerto 8080
# Útil para testing local o cuando no tienes subdominios configurados

:80 {
    # Routing basado en path
    handle /api/* {
        # API routes → Nginx API
        reverse_proxy nginx-api:80 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
            header_up Host {host}
            
            health_uri /up
            health_interval 30s
            health_timeout 5s
        }
    }
    
    handle {
        # Todo lo demás → Dashboard
        reverse_proxy dashboard:80 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
            header_up Host {host}
            
            health_uri /
            health_interval 30s
            health_timeout 5s
        }
    }

    # Logging
    log {
        output stdout
        format console
    }

    # Compression
    encode gzip
}



