<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".YapeNotifierApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.YapeNotifier"
        tools:targetApi="31">

        <!-- Splash Activity - App Entry Point with Session Management -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:label="NotiCentral"
            android:theme="@style/Theme.YapeNotifier.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PIN Login Activity (New authentication method) -->
        <activity
            android:name=".ui.PinLoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Login Activity (No longer the launcher) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- Register Activity -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- Create Commerce Activity -->
        <activity
            android:name=".ui.CreateCommerceActivity"
            android:exported="false"
            android:label="Crear Comercio"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- Main Activity (No longer the launcher) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- Captured Notifications Activity (Debug) -->
        <activity
            android:name=".ui.CapturedNotificationsActivity"
            android:exported="false"
            android:label="Notificaciones Guardadas"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- Debug Logs Activity -->
        <activity
            android:name=".ui.DebugLogsActivity"
            android:exported="false"
            android:label="Logs de Debug"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Link Device Activity -->
        <activity
            android:name=".ui.LinkDeviceActivity"
            android:exported="false"
            android:label="Vincular Dispositivo"
            android:theme="@style/Theme.YapeNotifier" />

        <!-- App Instances Activity -->
        <activity
            android:name=".ui.AppInstancesActivity"
            android:exported="false"
            android:label="Instancias de Aplicaciones"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Monitored Apps Selection Activity -->
        <activity
            android:name=".ui.MonitoredAppsSelectionActivity"
            android:exported="false"
            android:label="Apps Monitoreadas"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Permissions Wizard Activity -->
        <activity
            android:name=".ui.PermissionsWizardActivity"
            android:exported="false"
            android:label="Configuración Inicial"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Admin Module Activities -->
        <!-- ModeSelectionActivity - Mode chooser (no longer LAUNCHER) -->
        <activity
            android:name=".ui.admin.ModeSelectionActivity"
            android:exported="false"
            android:label="Seleccionar Modo"
            android:theme="@style/Theme.YapeNotifier" />
        
        <activity
            android:name=".ui.admin.AdminLoginActivity"
            android:exported="false"
            android:label="Admin Portal"
            android:theme="@style/Theme.YapeNotifier" />
        
        <activity
            android:name=".ui.admin.AdminPanelActivity"
            android:exported="false"
            android:label="Panel Admin"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />
        
        <activity
            android:name=".ui.admin.AdminAddDeviceActivity"
            android:exported="false"
            android:label="Conectar Dispositivo"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />
        
        <activity
            android:name=".ui.admin.AdminDevicesActivity"
            android:exported="false"
            android:label="Dispositivos"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />
        
        <activity
            android:name=".ui.admin.AdminSettingsActivity"
            android:exported="false"
            android:label="Configuración"
            android:theme="@style/Theme.YapeNotifier.NoActionBar" />

        <!-- Notification Listener Service (runs as foreground service to prevent system kill) -->
        <service
            android:name=".service.PaymentNotificationListenerService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notification listener for payment monitoring - must stay alive to capture payment notifications in real-time" />
        </service>

        <!-- FileProvider for sharing debug logs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Boot Completed Receiver - starts app process after device reboot -->
        <!-- The actual bootstrap (requestRebind) happens in Application.onCreate() -->
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Network Connectivity Receiver for automatic service recovery -->
        <!-- Used as fallback for API < 24. For API 24+, we use NetworkCallback -->
        <receiver
            android:name=".util.NetworkConnectivityReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
